NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Fleet map tiles (src/components/ui/vehicle-map.tsx). Free, no CARTO
# account needed — request one at https://carto.com/basemaps/apikey/
# (email/domain form, key arrives by email, no card). Fair use up to 5M
# tile requests/month. Safe to ship in the client bundle the same way the
# Supabase anon key is — it's a rate-limited public tile key, not a secret.
NEXT_PUBLIC_CARTO_API_KEY=

# ---- GPS integration (ROADMAP_NEXT.md item 2) — config slots, unset until
# a provider is confirmed. See STATUS.md's vendor-requirements list for the
# exact ask to each provider before these have real values. ----
# 'etit' or 'zhongtong' — which adapter in src/lib/gps/adapters/ is active.
GPS_PROVIDER=
ETIT_API_BASE_URL=
ETIT_API_KEY=
ZHONGTONG_API_BASE_URL=
ZHONGTONG_API_KEY=
# shared secret the provider sends back on each webhook call, checked by
# src/app/api/gps/webhook/route.ts against the x-webhook-secret header.
GPS_WEBHOOK_SECRET=
# if polling instead of a webhook: Vercel Cron's own bearer secret, checked
# by src/app/api/gps/poll/route.ts. Same variable Vercel's cron docs use.
CRON_SECRET=

# ---- Camera integration (ROADMAP_NEXT.md items 3-4) — the shared secret
# this app sends to a site's camera bridge (bridge/README.md). Must match
# that bridge's own BRIDGE_SHARED_SECRET. A camera_bridges row's base_url
# lives in the database, not here, since there can be more than one site.
CAMERA_BRIDGE_SHARED_SECRET=
