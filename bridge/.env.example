PORT=4100
# Shared secret the main app sends on x-bridge-secret. Generate a real
# random value and put the same one in the main app's
# CAMERA_BRIDGE_SHARED_SECRET env var — never commit the real value.
BRIDGE_SHARED_SECRET=
# Path to the per-camera config file (see cameras.config.example.json).
# Defaults to ./cameras.config.json if unset.
CAMERAS_CONFIG_PATH=./cameras.config.json
